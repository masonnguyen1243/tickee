{
  "name": "tickee",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev": "turbo dev dev:worker dev:tingee --ui=tui",
    "build": "turbo build",
    "typecheck": "sh scripts/dev-env.sh turbo typecheck",
    "test": "sh scripts/dev-env.sh turbo test",
    "test:e2e": "sh scripts/dev-env.sh turbo build --filter=@tickee/web && pnpm --filter @tickee/web test:e2e",
    "lint:deps": "turbo lint:deps",
    "db:seed": "pnpm --filter @tickee/api db:seed"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
