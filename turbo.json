{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_API_BASE_URL"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@tickee/web#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "lint:deps": {
      "inputs": ["src/**", "app/**", "components/**", "lib/**", "module-graph.cjs", ".dependency-cruiser.cjs", "tsconfig*.json"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "env": ["DATABASE_URL", "MIGRATION_DATABASE_URL"]
    }
  }
}
