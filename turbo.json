{
  "$schema": "https://turborepo.com/schema.json",
  "cacheMaxSize": "2GB",
  "cacheMaxAge": "7d",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@tickee/web#build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_API_BASE_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env.production.local", ".env.local", ".env.production", ".env"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@tickee/api#db:migrate": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@tickee/api#dev": {
      "dependsOn": ["db:migrate"],
      "cache": false,
      "persistent": true
    },
    "@tickee/api#dev:worker": {
      "dependsOn": ["db:migrate"],
      "cache": false,
      "persistent": true
    },
    "@tickee/api#dev:tingee": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@tickee/web#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "lint:deps": {
      "inputs": ["src/**", "app/**", "components/**", "lib/**", "module-graph.cjs", ".dependency-cruiser.cjs", "tsconfig*.json"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "env": ["DATABASE_URL", "MIGRATION_DATABASE_URL"]
    }
  }
}
