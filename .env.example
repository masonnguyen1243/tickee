# ---------- apps/api ----------
# Vai chạy của image api: api | worker | migrate
APP_ROLE=api
# development | test | production — BẮT BUỘC ở mọi vai, không có mặc định (thiếu thì dừng). Local: development. Image tự đặt
# production (cả staging). Ở production api/worker từ chối khởi động khi: URL công khai (API_PUBLIC_URL, WEB_ORIGIN,
# TINGEE_BASE_URL, S3_ENDPOINT, S3_PUBLIC_BASE_URL) không phải https; secret hoặc khóa vẫn là giá trị mẫu của file này;
# thiếu ADMIN_ALLOWED_CIDRS; hoặc thiếu AUTH_COOKIE_DOMAIN khi api và web khác host. Ở mọi môi trường: TICKET_QR_KEYS không
# được dùng chung khóa với TINGEE_CREDENTIAL_KEYS, và AUTH_COOKIE_DOMAIN (nếu đặt) phải là miền cha của cả hai origin.
# Xem README › "Cấu hình staging/production".
NODE_ENV=development
LOG_LEVEL=info
# Chỉ vai api dùng
PORT=3001
# Số proxy tin cậy trước api (vd. 1 khi sau một load balancer) để giới hạn OTP theo IP và giới hạn IP của /v1/admin/*
# dùng IP thật. Local: 0. Phải BẰNG ĐÚNG số proxy trước api: thấp hơn thì req.ip là IP của proxy; CAO HƠN thì mục
# X-Forwarded-For do client tự gửi thành req.ip, ai cũng tự nhận được một IP trong ADMIN_ALLOWED_CIDRS.
TRUST_PROXY_HOPS=0
# Dải IP được gọi khu Quản trị Tingee /v1/admin/* (Story 4.7-a) — chỉ vai api đọc. CIDR IPv4/IPv6 cách nhau bằng dấu
# phẩy, vd. `203.0.113.0/24,2001:db8::/32` (IP trần = /32 hoặc /128; không nhận /0, không nhận dải IPv6 chồng lên
# ::ffff:0:0/96). IP client là req.ip theo TRUST_PROXY_HOPS. Mọi method từ IP ngoài dải nhận 403 ADMIN_IP_NOT_ALLOWED
# trước cả đăng nhập; riêng preflight CORS `OPTIONS` do lớp CORS trả trước khi kiểm IP (không dữ liệu, không log chặn) để
# trình duyệt đọc được mã 403. /admin hiện "Bạn đang truy cập từ mạng không được phép." BẮT BUỘC khi NODE_ENV=production
# (cả staging): thiếu hoặc sai thì api không khởi động; có thì api log `info` số dải IPv4/IPv6 lúc khởi động. KHÔNG BAO
# GIỜ "sửa" admin bị chặn bằng cách thêm dải nội bộ của load balancer hay VPC vào đây: mọi request đi qua LB sẽ vào được.
# Sửa TRUST_PROXY_HOPS cho đúng. ĐỂ TRỐNG ở local = không giới hạn (api log `warn` lúc khởi động). Thử ở local:
# `127.0.0.1/32,::1/128` (trình duyệt trên máy này qua), hoặc `203.0.113.0/24` (bị chặn).
ADMIN_ALLOWED_CIDRS=
# Role DML (tickee_app) — vai api và worker
DATABASE_URL=postgresql://tickee_app:tickee_app@localhost:5432/tickee
# Role DDL (tickee_migrator) — vai migrate (`pnpm dev` tự chạy trước api/worker), `pnpm db:seed`, `admin:grant`
MIGRATION_DATABASE_URL=postgresql://tickee_migrator:tickee_migrator@localhost:5432/tickee

# Đăng nhập (Better Auth) — chỉ vai api
# Khóa ký session/cookie, ≥ 32 ký tự. Giá trị dưới CHỈ dùng ở local; môi trường thật sinh bằng `openssl rand -base64 32`.
BETTER_AUTH_SECRET=local-dev-only-doi-khoa-nay-o-moi-moi-truong-that
# Origin công khai của api (Better Auth mount ở <origin>/v1/auth; URL IPN của BTC là <origin>/v1/payments/tingee/ipn/…).
# Tingee fake cũng đọc biến này để biết sẵn URL IPN của BTC demo (mặc định http://localhost:3001)
API_PUBLIC_URL=http://localhost:3001
# Origin của web, không có / cuối: api cho CORS kèm cookie; worker dùng làm gốc link trong email và gọi
# <WEB_ORIGIN>/api/revalidate khi BTC sửa Sự kiện đã mở bán
WEB_ORIGIN=http://localhost:3000
# Bí mật dùng chung worker ↔ web cho route revalidate trang Sự kiện công khai — BẮT BUỘC với vai worker (≥ 32 ký tự,
# thiếu thì worker dừng). Web phải đặt CÙNG giá trị (chỉ ở server, không NEXT_PUBLIC_). Giá trị dưới CHỈ dùng ở local;
# môi trường thật sinh bằng `openssl rand -base64 32`. Không commit giá trị thật.
REVALIDATE_SECRET=local-dev-only-revalidate-doi-khoa-nay-o-moi-truong-that
# Tên miền cha để cookie session dùng chung web và api (vd. tickee.vn). Bỏ trống ở local. Đặt thì host của API_PUBLIC_URL
# và WEB_ORIGIN phải bằng miền này hoặc là miền con của nó (không phân biệt hoa thường, dấu . đầu bỏ qua). Ở production mà
# api và web khác host (api.tickee.vn, tickee.vn) thì bắt buộc: SSR của web chuyển tiếp cookie của web sang api.
AUTH_COOKIE_DOMAIN=
# Gửi email (api: mã OTP; worker: lời mời Admin). Local: Mailpit của docker compose, xem thư ở http://localhost:8025
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Tickee <no-reply@tickee.local>
# Đăng nhập Google — BẮT BUỘC với vai api (thiếu thì api dừng ngay). Tạo OAuth client loại "Web application" tại
# https://console.cloud.google.com/apis/credentials, Authorized redirect URI: http://localhost:3001/v1/auth/callback/google
# (= <API_PUBLIC_URL>/v1/auth/callback/google). Không commit giá trị thật. Giá trị giữ chỗ dưới đây chỉ để api khởi động
# được; nút "Tiếp tục với Google" không dùng được cho tới khi thay bằng client ID/secret thật.
GOOGLE_CLIENT_ID=local-placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=local-placeholder-secret
# Tingee Open API — BẮT BUỘC với vai api và worker (worker: Đối soát bù đi cùng đường xử lý IPN). UAT:
# https://uat-open-api.tingee.vn. Env không có credential Tingee nào: mỗi BTC nhập API key Tingee của chính mình ở trang
# Tài khoản nhận tiền (Secret Token lưu mã hóa trong DB).
# Local: Tingee fake (cổng 4010) chạy sẵn trong `pnpm dev`. BTC demo của `pnpm db:seed` đã liên kết merchant demo; hoặc
# nhập key của một merchant demo (key giả, chỉ có nghĩa với fake):
#   demo-btc-co-tai-khoan / demo-secret-co-tai-khoan     (có tài khoản, kèm một VietinBank hiện mờ)
#   demo-btc-chua-lien-ket / demo-secret-chua-lien-ket   (chưa liên kết ngân hàng nào → empty-state)
# Đơn có phí ở local: trang thanh toán giả của fake có nút "Đã thanh toán (giả lập)", "Hết hạn", "Hủy" gửi IPN đã ký tới
# api rồi về Trang Đơn. BTC demo của `pnpm db:seed` không cần cấu hình gì; BTC khác dán "URL IPN" (trang Tài khoản nhận
# tiền) vào ô "Đường dẫn IPN" trên trang giả. Xem README › "Thanh toán Đơn có phí ở local".
# `.env` local PHẢI là http://localhost:4010: trỏ Tingee thật thì key demo lỗi (xem README › "Hai bẫy của `.env` local").
TINGEE_BASE_URL=http://localhost:4010
# Đối soát bù (Story 4.1) — chỉ vai worker đọc: `true` thì worker tra trạng thái đơn Gateway khi IPN trễ hoặc mất (lần
# đầu sau 2 phút kể từ lúc tạo link, rồi theo lịch tới 24 giờ sau khi Đơn hết hạn). Tingee chưa công bố API tra đơn: chỉ
# Tingee fake hiểu hợp đồng tạm, nên chỉ bật ở local. Thiếu biến = tắt (job tra xong ngay, không gọi Tingee).
# Thử ở local: nhập "Đường dẫn IPN" sai trên trang thanh toán giả rồi bấm "Đã thanh toán (giả lập)" (IPN mất); khoảng 2
# phút sau worker tra fake và phát Vé.
TINGEE_ORDER_STATUS_QUERY=true
# Khóa AES-256-GCM mã hóa Secret Token Tingee của BTC — BẮT BUỘC với vai api và worker (api giải mã để tạo link và kiểm
# chữ ký IPN): `v<k>:<base64 của 32 byte>`, nhiều khóa cách nhau bằng dấu phẩy, không trùng k. Mã hóa bằng khóa có k lớn nhất; khi xoay khóa thì thêm `,v2:…` và giữ v1 tới khi không còn dòng nào dùng.
# Giá trị dưới CHỈ dùng ở local; môi trường thật sinh bằng `openssl rand -base64 32`. Không commit khóa thật.
# `pnpm db:seed` cũng đọc biến này để mã hóa key demo (api phải giải mã được).
# KHÔNG BAO GIỜ đổi giá trị của phiên bản khóa đã dùng; muốn đổi thì thêm v<k+1> (README › "Hai bẫy của `.env` local").
TINGEE_CREDENTIAL_KEYS=v1:H0ifJtEFLX+lF7uW8Yp0o5tbO7bfViFxKAaALW0fOWg=
# Khóa HMAC-SHA256 ký Mã QR vé — BẮT BUỘC với vai api và worker (thiếu hoặc sai dạng thì dừng). Cùng dạng với
# TINGEE_CREDENTIAL_KEYS (`v<k>:<base64 của 32 byte>`, nhiều khóa cách nhau bằng dấu phẩy), nhưng là khóa KHÁC (dùng
# chung một khóa với TINGEE_CREDENTIAL_KEYS thì api/worker dừng, ở mọi môi trường). Ký Vé mới bằng khóa có k lớn nhất;
# Vé nhớ k nên QR không đổi khi xoay khóa, miễn giữ khóa cũ trong danh sách. Giá trị dưới CHỈ dùng ở local; môi trường
# thật sinh bằng `openssl rand -base64 32`. Không commit khóa thật.
# KHÔNG BAO GIỜ đổi giá trị của phiên bản khóa đã dùng; muốn đổi thì thêm v<k+1> (README › "Hai bẫy của `.env` local").
TICKET_QR_KEYS=v1:XKzZ7wJ1m6M2fCq9yQb0n3T4sVhR8dLpA5eGiUoWkYc=

# Ảnh Sự kiện trên object storage tương thích S3 (Story 4.8-a) — BẮT BUỘC với vai api (thiếu thì api dừng); worker không
# đọc. Api chỉ ký presigned PUT (không gọi mạng tới storage) và dựng URL công khai của ảnh: trình duyệt PUT thẳng lên
# S3_ENDPOINT rồi đọc ảnh ở S3_PUBLIC_BASE_URL, nên cả hai phải mở được từ trình duyệt.
# Local: MinIO của `docker compose up -d --wait` (bucket tickee-event-images đã tạo sẵn, đọc ẩn danh từng object, CORS cho
# http://localhost:3000). Console MinIO: http://localhost:9001 (tickee-local / tickee-local-secret).
S3_ENDPOINT=http://localhost:9000
# Region ký SigV4 (mặc định us-east-1; MinIO nhận mọi giá trị).
S3_REGION=us-east-1
S3_BUCKET=tickee-event-images
# Credential S3 chỉ cần quyền PutObject trên bucket. Giá trị dưới CHỈ dùng ở local (root user của MinIO trong
# docker-compose.yml). Không commit giá trị thật.
S3_ACCESS_KEY_ID=tickee-local
S3_SECRET_ACCESS_KEY=tickee-local-secret
# `true`: URL dạng <endpoint>/<bucket>/<key> (MinIO cần); mặc định false: <bucket>.<host>/<key>.
S3_FORCE_PATH_STYLE=true
# Gốc URL công khai của ảnh: imageUrl = <S3_PUBLIC_BASE_URL>/<key>. Sau CDN thì là gốc của CDN.
S3_PUBLIC_BASE_URL=http://localhost:9000/tickee-event-images

# OpenTelemetry (Story 4.6-a) — chỉ vai api và worker: trace và metrics xuất OTLP/HTTP tới một collector bất kỳ (log vẫn là
# JSON ra stdout, không qua OTLP). ĐỂ TRỐNG = tắt hẳn (không khởi SDK, không hook nào), như trước 4.6-a.
# Bật ở local: `docker compose --profile observability up -d otel-lgtm`, đặt OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318,
# chạy lại `pnpm dev`, rồi mở Grafana ở http://localhost:3030 (Explore › Tempo cho trace, Prometheus cho metrics).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Header gửi kèm mỗi lần xuất, dạng `key=value` cách nhau bằng dấu phẩy, giá trị percent-encode được (vd.
# `authorization=Bearer%20<token>`). Là SECRET: không log, không commit. otel-lgtm ở local không cần.
# OTEL_EXPORTER_OTLP_HEADERS=
# Chu kỳ xuất metrics (ms), mặc định 60000; tối thiểu 1000.
# OTEL_METRIC_EXPORT_INTERVAL=60000

# Cảnh báo vận hành (Story 4.6-b) — kênh trong app: worker gửi email `[Tickee vận hành] …` cho đội vận hành khi tiền về
# không khớp Đơn, Đối soát bù dừng, link chia sẻ Vé thiếu khóa QR, hàng đợi pg-boss ùn, có job vào dead-letter, lưới an
# toàn bắt Đơn quá hạn hay tồn kho lệch, IPN lỗi tăng, tạo link chậm, hoặc tỉ lệ phát Vé giảm (README › "Cảnh báo vận
# hành"). Người nhận (chỉ worker đọc): email cách nhau bằng dấu phẩy. ĐỂ TRỐNG = chỉ ghi log `error` kèm `alert` (worker
# log `warn` lúc khởi động và mỗi lần có cảnh báo). Cảnh báo phát hiện khi biến này trống vẫn được ghi dấu chống lặp: đặt
# người nhận sau thì chúng không được gửi email lại. Thử ở local: đặt vd. `van-hanh@tickee.local`, xem thư ở Mailpit
# http://localhost:8025.
OPS_ALERT_EMAILS=
# Loại có cooldown (thiếu khóa QR, hàng đợi ùn, IPN lỗi tăng, tạo link chậm, tỉ lệ phát Vé giảm) báo lại cùng đối tượng
# sau chừng này phút (api và worker); mặc định 30.
# OPS_ALERT_COOLDOWN_MINUTES=30
# Job tới hạn quá chừng này phút mà chưa chạy thì báo hàng đợi ùn (worker); mặc định 5.
# OPS_ALERT_QUEUE_WAIT_MINUTES=5
# Luật cảnh báo nghiệp vụ (Story 4.6-e). Ngưỡng là số nguyên ≥ 1. Hai luật của api đếm trong bộ nhớ, cửa sổ 5 phút, mỗi
# instance api đếm riêng:
# - IPN lỗi (401 chữ ký/timestamp sai, 400 body hỏng, 5xx) trong 5 phút để báo (api); mặc định 5.
# OPS_ALERT_IPN_FAILURES=5
# - p95 thời gian tạo link thanh toán (create-link của Tingee) trong 5 phút phải vượt chừng này ms để báo (api); mặc định 2000,
#   chỉ xét khi có từ OPS_ALERT_LINK_MIN_SAMPLES lần gọi (mặc định 20).
# OPS_ALERT_LINK_P95_MS=2000
# OPS_ALERT_LINK_MIN_SAMPLES=20
# - Tỉ lệ Đơn có link được trả tiền trong khung 75 → 15 phút trước dưới OPS_ALERT_ISSUANCE_RATIO (số trong (0, 1],
#   mặc định 0.5) lần tỉ lệ của cùng khung 7 ngày trước, khi khung có từ OPS_ALERT_ISSUANCE_MIN_ORDERS Đơn (mặc định 10)
#   (worker, job quét mỗi phút).
# OPS_ALERT_ISSUANCE_MIN_ORDERS=10
# OPS_ALERT_ISSUANCE_RATIO=0.5

# ---------- apps/web ----------
# Gốc REST của api (client tự thêm /v1). Biến NEXT_PUBLIC_* được nhúng lúc build. Web không đọc file .env ở gốc repo:
# `next dev` lấy từ apps/web/.env.development; `pnpm typecheck`, `pnpm test`, `pnpm test:e2e` tự đặt http://localhost:3001
# cho bản build (scripts/dev-env.sh). Build để deploy phải tự đặt biến; thiếu thì `next build` dừng.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Bật trang /ui-kit (bộ giao diện) — chỉ đặt 1 ở local/CI; production không đặt nên /ui-kit trả 404.
# TICKEE_UI_KIT=1
# Server-only: worker gọi POST /api/revalidate kèm `Authorization: Bearer <REVALIDATE_SECRET>` (cùng giá trị với
# REVALIDATE_SECRET của worker ở trên). Thiếu thì route trả 503 và trang /e/{slug} chỉ tự làm mới sau 30 giây.
# Web (`next dev` lẫn `next start`) không đọc file .env ở gốc repo: đặt biến này trong apps/web/.env.local (không commit).
# REVALIDATE_SECRET=local-dev-only-revalidate-doi-khoa-nay-o-moi-truong-that
