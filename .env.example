# ---------- apps/api ----------
# Vai chạy của image api: api | worker | migrate
APP_ROLE=api
NODE_ENV=development
LOG_LEVEL=info
# Chỉ vai api dùng
PORT=3001
# Role DML (tickee_app) — vai api và worker
DATABASE_URL=postgresql://tickee_app:tickee_app@localhost:5432/tickee
# Role DDL (tickee_migrator) — chỉ vai migrate
MIGRATION_DATABASE_URL=postgresql://tickee_migrator:tickee_migrator@localhost:5432/tickee

# ---------- apps/web ----------
NEXT_PUBLIC_API_URL=http://localhost:3001
