# ---------- apps/api ----------
# Vai chạy của image api: api | worker | migrate
APP_ROLE=api
NODE_ENV=development
LOG_LEVEL=info
# Chỉ vai api dùng
PORT=3001
# Số proxy tin cậy trước api (vd. 1 khi sau một load balancer) để giới hạn OTP theo IP dùng IP thật. Local: 0.
TRUST_PROXY_HOPS=0
# Role DML (tickee_app) — vai api và worker
DATABASE_URL=postgresql://tickee_app:tickee_app@localhost:5432/tickee
# Role DDL (tickee_migrator) — vai migrate (`pnpm dev` tự chạy trước api/worker), `pnpm db:seed`, `admin:grant`
MIGRATION_DATABASE_URL=postgresql://tickee_migrator:tickee_migrator@localhost:5432/tickee

# Đăng nhập (Better Auth) — chỉ vai api
# Khóa ký session/cookie, ≥ 32 ký tự. Giá trị dưới CHỈ dùng ở local; môi trường thật sinh bằng `openssl rand -base64 32`.
BETTER_AUTH_SECRET=local-dev-only-doi-khoa-nay-o-moi-moi-truong-that
# Origin công khai của api (Better Auth mount ở <origin>/v1/auth; URL IPN của BTC là <origin>/v1/payments/tingee/ipn/…).
# Tingee fake cũng đọc biến này để biết sẵn URL IPN của BTC demo (mặc định http://localhost:3001)
API_PUBLIC_URL=http://localhost:3001
# Origin của web, không có / cuối: api cho CORS kèm cookie; worker dùng làm gốc link trong email và gọi
# <WEB_ORIGIN>/api/revalidate khi BTC sửa Sự kiện đã mở bán
WEB_ORIGIN=http://localhost:3000
# Bí mật dùng chung worker ↔ web cho route revalidate trang Sự kiện công khai — BẮT BUỘC với vai worker (≥ 32 ký tự,
# thiếu thì worker dừng). Web phải đặt CÙNG giá trị (chỉ ở server, không NEXT_PUBLIC_). Giá trị dưới CHỈ dùng ở local;
# môi trường thật sinh bằng `openssl rand -base64 32`. Không commit giá trị thật.
REVALIDATE_SECRET=local-dev-only-revalidate-doi-khoa-nay-o-moi-truong-that
# Tên miền cha để cookie session dùng chung web và api (vd. tickee.vn). Bỏ trống ở local.
AUTH_COOKIE_DOMAIN=
# Gửi email (api: mã OTP; worker: lời mời Admin). Local: Mailpit của docker compose, xem thư ở http://localhost:8025
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Tickee <no-reply@tickee.local>
# Đăng nhập Google — BẮT BUỘC với vai api (thiếu thì api dừng ngay). Tạo OAuth client loại "Web application" tại
# https://console.cloud.google.com/apis/credentials, Authorized redirect URI: http://localhost:3001/v1/auth/callback/google
# (= <API_PUBLIC_URL>/v1/auth/callback/google). Không commit giá trị thật. Giá trị giữ chỗ dưới đây chỉ để api khởi động
# được; nút "Tiếp tục với Google" không dùng được cho tới khi thay bằng client ID/secret thật.
GOOGLE_CLIENT_ID=local-placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=local-placeholder-secret
# Tingee Open API — BẮT BUỘC với vai api và worker (worker: Đối soát bù đi cùng đường xử lý IPN). UAT:
# https://uat-open-api.tingee.vn. Env không có credential Tingee nào: mỗi BTC nhập API key Tingee của chính mình ở trang
# Tài khoản nhận tiền (Secret Token lưu mã hóa trong DB).
# Local: Tingee fake (cổng 4010) chạy sẵn trong `pnpm dev`. BTC demo của `pnpm db:seed` đã liên kết merchant demo; hoặc
# nhập key của một merchant demo (key giả, chỉ có nghĩa với fake):
#   demo-btc-co-tai-khoan / demo-secret-co-tai-khoan     (có tài khoản, kèm một VietinBank hiện mờ)
#   demo-btc-chua-lien-ket / demo-secret-chua-lien-ket   (chưa liên kết ngân hàng nào → empty-state)
# Đơn có phí ở local: trang thanh toán giả của fake có nút "Đã thanh toán (giả lập)", "Hết hạn", "Hủy" gửi IPN đã ký tới
# api rồi về Trang Đơn. BTC demo của `pnpm db:seed` không cần cấu hình gì; BTC khác dán "URL IPN" (trang Tài khoản nhận
# tiền) vào ô "Đường dẫn IPN" trên trang giả. Xem README › "Thanh toán Đơn có phí ở local".
TINGEE_BASE_URL=http://localhost:4010
# Khóa AES-256-GCM mã hóa Secret Token Tingee của BTC — BẮT BUỘC với vai api và worker (api giải mã để tạo link và kiểm
# chữ ký IPN): `v<k>:<base64 của 32 byte>`, nhiều khóa cách nhau bằng dấu phẩy, không trùng k. Mã hóa bằng khóa có k lớn nhất; khi xoay khóa thì thêm `,v2:…` và giữ v1 tới khi không còn dòng nào dùng.
# Giá trị dưới CHỈ dùng ở local; môi trường thật sinh bằng `openssl rand -base64 32`. Không commit khóa thật.
# `pnpm db:seed` cũng đọc biến này để mã hóa key demo (api phải giải mã được).
TINGEE_CREDENTIAL_KEYS=v1:H0ifJtEFLX+lF7uW8Yp0o5tbO7bfViFxKAaALW0fOWg=
# Khóa HMAC-SHA256 ký Mã QR vé — BẮT BUỘC với vai api và worker (thiếu hoặc sai dạng thì dừng). Cùng dạng với
# TINGEE_CREDENTIAL_KEYS (`v<k>:<base64 của 32 byte>`, nhiều khóa cách nhau bằng dấu phẩy), nhưng là khóa KHÁC. Ký Vé
# mới bằng khóa có k lớn nhất; Vé nhớ k nên QR không đổi khi xoay khóa, miễn giữ khóa cũ trong danh sách. Giá trị dưới
# CHỈ dùng ở local; môi trường thật sinh bằng `openssl rand -base64 32`. Không commit khóa thật.
TICKET_QR_KEYS=v1:XKzZ7wJ1m6M2fCq9yQb0n3T4sVhR8dLpA5eGiUoWkYc=

# ---------- apps/web ----------
# Gốc REST của api (client tự thêm /v1). Biến NEXT_PUBLIC_* được nhúng lúc build. Web không đọc file .env ở gốc repo:
# `next dev` lấy từ apps/web/.env.development; `pnpm typecheck`, `pnpm test`, `pnpm test:e2e` tự đặt http://localhost:3001
# cho bản build (scripts/dev-env.sh). Build để deploy phải tự đặt biến; thiếu thì `next build` dừng.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Bật trang /ui-kit (bộ giao diện) — chỉ đặt 1 ở local/CI; production không đặt nên /ui-kit trả 404.
# TICKEE_UI_KIT=1
# Server-only: worker gọi POST /api/revalidate kèm `Authorization: Bearer <REVALIDATE_SECRET>` (cùng giá trị với
# REVALIDATE_SECRET của worker ở trên). Thiếu thì route trả 503 và trang /e/{slug} chỉ tự làm mới sau 30 giây.
# Web (`next dev` lẫn `next start`) không đọc file .env ở gốc repo: đặt biến này trong apps/web/.env.local (không commit).
# REVALIDATE_SECRET=local-dev-only-revalidate-doi-khoa-nay-o-moi-truong-that
